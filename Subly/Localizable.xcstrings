    "⏰ %@ si rinnova tra 3 giorni (%@). È il momento di chiederti: mi serve davvero?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⏰ %@ renews in 3 days (%@). It's time to ask yourself: do I really need it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⏰ %@ se renueva en 3 días (%@). Es el momento de preguntarte: ¿me sirve de verdad?"
          }
        }
      }
    },
    "⚠️ Domani si rinnova %@ (%@). Ultima chance per ripensarci!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ %@ renews tomorrow (%@). Last chance to reconsider!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Mañana se renueva %@ (%@). ¡Última oportunidad para pensarlo!"
          }
        }
      }
    },
    "✈️ %@/anno in abbonamenti = un viaggio che ricorderai per sempre" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✈️ %@/year in subscriptions = a trip you'll remember forever"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✈️ %@/año en suscripciones = un viaje que recordarás siempre"
          }
        }
      }
    },
    "💡 Il tuo consiglio finanziario" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Your financial tip"
