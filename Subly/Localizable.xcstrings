          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti aiutiamo noi a cancellare questo servizio"
          }
        }
      }
    },
    "Ti avvisiamo 3 giorni prima del rinnovo chiedendoti se usi ancora il servizio. Tu decidi, noi ti aiutiamo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We notify you 3 days before renewal asking if you still use the service. You decide, we help you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisamos 3 días antes de la renovación preguntándote si aún usas el servicio. Tú decides, nosotros te ayudamos."
          }
        }
      }
    },
