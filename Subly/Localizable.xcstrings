    "Ti mostreremo cosa potresti fare con i soldi che spendi: viaggi, cene, esperienze. Vale la pena continuare a pagare?" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll show you what you could do with the money you spend: trips, dinners, experiences. Is it worth continuing to pay?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te mostraremos qué podrías hacer con el dinero que gastas: viajes, cenas, experiencias. ¿Vale la pena seguir pagando?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti mostreremo cosa potresti fare con i soldi che spendi: viaggi, cene, esperienze. Vale la pena continuare a pagare?"
          }
        }
      }
    },
