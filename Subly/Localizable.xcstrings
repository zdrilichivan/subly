    "I tuoi dati sono al sicuro e sempre sincronizzati su tutti i tuoi dispositivi Apple.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is safe and always synced across all your Apple devices."
          }
        },
