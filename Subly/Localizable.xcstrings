        }
      }
    },
    "💸 Questo mese spendi %@ in abbonamenti. Con gli stessi soldi potresti..." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💸 This month you spend %@ on subscriptions. With the same money you could..."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💸 Este mes gastas %@ en suscripciones. Con el mismo dinero podrías..."
          }
        }
      }
    },
    "📅 Oggi si rinnova %@ (%@). Hai ancora bisogno di questo servizio?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "📅 %@ renews today (%@). Do you still need this service?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "📅 Hoy se renueva %@ (%@). ¿Aún necesitas este servicio?"
          }
        }
      }
    },
    "🤔 Hai %lld abbonamenti attivi. Li usi davvero tutti?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 You have %lld active subscriptions. Do you really use them all?"
          }
        },
