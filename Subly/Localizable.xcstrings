    "Ti aiutiamo a risparmiare! Tocca il pulsante qui sotto per andare alla pagina di disdetta." : {
      "comment" : "Cancellation help description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll help you save! Tap the button below to go to the cancellation page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Te ayudamos a ahorrar! Toca el botón de abajo para ir a la página de cancelación."
          }
        }
      }
    },
    "Ti aiutiamo noi a cancellare questo servizio" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We help you cancel this service"
          }
