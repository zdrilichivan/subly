        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de 100 servicios disponibles. Descubre cuánto gastas cada mes y año de un vistazo."
          }
        }
      }
    },
    "Ottimo! Hai solo l'essenziale." : {
