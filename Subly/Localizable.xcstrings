          "stringUnit": {
            "state": "translated",
            "value": "Set up an automatic transfer on payday: even just €50/month to a savings account. You won't see that money and you won't miss it. In 5 years you'll have €3,000+."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Programa una transferencia el día de cobro: aunque sean solo 50€/mes a una cuenta de ahorro. No verás ese dinero y no lo echarás de menos. En 5 años tendrás más de 3.000€."
          }
        }
      }
    },
