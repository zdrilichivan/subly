    "Spotify Family, Netflix, Disney+: dividi con amici o parenti. Un Netflix da €18/mese diviso in 4 costa €4.50 a testa. Risparmio: €160/anno solo su questo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify Family, Netflix, Disney+: share with friends or relatives. An €18/month Netflix shared by 4 costs €4.50 each. Savings: €160/year just on this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify Family, Netflix, Disney+: divide con amigos o parientes. Un Netflix de 18€/mes dividido entre 4 cuesta 4,50€ por cabeza. Ahorro: 160€/año solo en esto."
          }
        }
      }
    },
