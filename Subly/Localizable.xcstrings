    "Tutti gli abbonamenti e le impostazioni verranno eliminati. L'app tornerà come appena installata.\n\nQuesta azione non può essere annullata.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All subscriptions and settings will be deleted. The app will revert to a fresh install state.\n\nThis action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las suscripciones y configuraciones serán eliminadas. La app volverá a estar como recién instalada.\n\nEsta acción no se puede deshacer."
          }
        }
      }
    },
