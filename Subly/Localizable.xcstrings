        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuántas horas trabajas para pagar todas estas suscripciones? ¿De verdad merece la pena?"
          }
        }
      }
    },
    "Quanto posso realisticamente mettere da parte?": {
