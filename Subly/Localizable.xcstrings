    "Abbonamento Annuale Premium: %@/anno. Rinnovo automatico annuale. Puoi annullare in qualsiasi momento dalle Impostazioni.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium Annual Subscription: %@/year. Auto-renews yearly. Cancel anytime in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscripción Anual Premium: %@/año. Renovación automática anual. Puedes cancelar en cualquier momento desde Ajustes."
          }
        }
      }
    },
    "Abbonamento Annuale Premium: prova gratuita di 3 giorni, poi %@/anno. Rinnovo automatico annuale. Puoi annullare in qualsiasi momento dalle Impostazioni.": {},
    "Abbonamento Settimanale Premium: prova gratuita di 3 giorni, poi %@/settimana. Rinnovo automatico settimanale. Puoi annullare in qualsiasi momento dalle Impostazioni.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium Weekly Subscription: 3-day free trial, then %@/week. Auto-renews weekly. Cancel anytime in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscripción Semanal Premium: prueba gratuita de 3 días, luego %@/semana. Renovación automática semanal. Puedes cancelar en cualquier momento desde Ajustes."
          }
        }
      }
    },
