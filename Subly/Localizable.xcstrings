    "I tuoi abbonamenti ti costano quanto %@. Ne vale la pena?": {},
    "I tuoi dati restano sul tuo dispositivo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays on your device"
          }
        }
      }
    },
    "I tuoi dati sono al sicuro su iCloud e sincronizzati su tutti i tuoi dispositivi Apple.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is safe on iCloud and synced across all your Apple devices."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono al sicuro su iCloud e sincronizzati su tutti i tuoi dispositivi Apple."
          }
        }
      }
    },
    "I voli costano meno se prenotati il martedì pomeriggio. I prezzi sono più alti nel weekend quando tutti cercano. Stesso volo, giorno diverso, €50-200 di differenza.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flights cost less if booked on Tuesday afternoon. Prices are higher on the weekend when everyone is searching. Same flight, different day, €50-200 difference."
          }
        }
      }
    },
    "iCloud non disponibile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud not available"
          }
        }
      }
    },
    "Identifica l'obiettivo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identify the goal"
          }
        }
